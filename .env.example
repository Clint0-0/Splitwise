# SplitWise+ configuration. Copy to .env for local use and fill in.
# NEVER commit .env. On Vercel, set these in Project -> Settings -> Environment Variables
# (real environment variables always override .env).
# Comments go on their own line (Docker --env-file does not strip trailing comments).
# Quote values that contain spaces or start with #, e.g. DB_PASSWORD="my #pass".

# local | production   (production forces debug off, HSTS, logs to stderr)
APP_ENV=local
# ignored when APP_ENV=production
APP_DEBUG=true
APP_URL=http://localhost/Splitwise/public
# true only behind a proxy that appends the visitor IP (Vercel): trusts X-Forwarded-For / -Proto
APP_TRUST_PROXY=false

# MySQL 8.0 (DB_PASS is still accepted for older .env files)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=splitwise_plus
DB_USER=splitwise_app
DB_PASSWORD=change_me
# seconds
DB_CONNECT_TIMEOUT=5
# true for managed MySQL (TLS). DB_SSL_CA = provider CA file; empty = system CA bundle.
DB_SSL=false
DB_SSL_CA=
# verify the server certificate when DB_SSL=true (keep true in production)
DB_SSL_VERIFY=true

# Sessions: database (shared by all instances) | files (single local server only)
SESSION_NAME=splitwise_sess
SESSION_DRIVER=database
# idle timeout, seconds
SESSION_LIFETIME=7200

# receipts, max 5 MB (stored in MySQL)
UPLOAD_MAX_BYTES=5242880
# mock e-mail output: file path or "stderr"; empty = storage/logs/mail.log (local) / stderr (production)
MAIL_LOG=

# Bill scanning (Phase 6): off | mock (demo bill, never in production) | groq | anthropic (vision APIs)
SCAN_PROVIDER=off
# API key for SCAN_PROVIDER=groq (gsk_..., from console.groq.com -> API Keys) or =anthropic.
# Set it in your host's secret/env settings, or in your local .env (git-ignored).
# Never commit it, never put it in a Docker image, never paste it into a chat.
SCAN_API_KEY=
# optional model override (empty = the app's default: groq -> qwen/qwen3.8-27b,
# anthropic -> claude-sonnet-5-5). Groq renames models: check console.groq.com/docs/vision
SCAN_MODEL=
# optional: path to a CA certificate file for HTTPS (Windows/XAMPP PHP often has none).
# Empty = php.ini curl.cainfo, else XAMPP's own cacert.pem, else the system store.
SCAN_CA_BUNDLE=
# scans per user per day (each real scan costs money)
SCAN_DAILY_LIMIT=20
# whole-site scans per month (hard spending cap) and the estimated cost of one scan in paise (admin page)
SCAN_MONTHLY_LIMIT=1000
SCAN_COST_PAISE=70

# E-mail (Phase 6): log = write to MAIL_LOG (nothing sent) | smtp = really send
MAIL_DRIVER=log
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=SplitWise+
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | tls (port 465) | none (local testing only, refused in production)
SMTP_ENCRYPTION=starttls
SMTP_USER=
# secret: set it in the host's environment settings, never commit it
SMTP_PASSWORD=
# public address of the site, used in password-reset links (required in production)
APP_URL=

# Error monitoring (optional): Sentry or a Sentry-compatible DSN (secret-ish: keep it out of git)
SENTRY_DSN=

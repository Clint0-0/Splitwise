# SplitWise+ configuration. Copy to .env for local use and fill in.
# NEVER commit .env. On Vercel, set these in Project -> Settings -> Environment Variables
# (real environment variables always override .env).

APP_ENV=local                 # local | production   (production forces debug off, HSTS, logs to stderr)
APP_DEBUG=true                # ignored when APP_ENV=production
APP_URL=http://localhost/Splitwise/public
APP_TRUST_PROXY=false         # true behind Vercel: trust X-Forwarded-For / X-Forwarded-Proto

# MySQL 8.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=splitwise_plus
DB_USER=splitwise_app
DB_PASSWORD=change_me         # (DB_PASS is still accepted for older .env files)
DB_CONNECT_TIMEOUT=5          # seconds
DB_SSL=false                  # true for managed MySQL (TLS)
DB_SSL_CA=                    # optional path to the provider CA file; default = system CA bundle
DB_SSL_VERIFY=true            # verify the server certificate when DB_SSL=true

# Sessions (stored in MySQL table app_sessions, shared by all instances)
SESSION_NAME=splitwise_sess
SESSION_DRIVER=database       # database | files (files = single local server only)
SESSION_LIFETIME=7200         # idle timeout in seconds

UPLOAD_MAX_BYTES=5242880      # receipts, max 5 MB (stored in MySQL)
MAIL_LOG=                     # mock e-mail output: file path, or "stderr"; default storage/logs/mail.log (local) / stderr (production)

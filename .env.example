# SplitWise+ configuration. Copy to .env for local use and fill in.
# NEVER commit .env. On Vercel, set these in Project -> Settings -> Environment Variables
# (real environment variables always override .env).
# Comments go on their own line (Docker --env-file does not strip trailing comments).
# Quote values that contain spaces or start with #, e.g. DB_PASSWORD="my #pass".

# local | production   (production forces debug off, HSTS, logs to stderr)
APP_ENV=local
# ignored when APP_ENV=production
APP_DEBUG=true
APP_URL=http://localhost/Splitwise/public
# true only behind a proxy that appends the visitor IP (Vercel): trusts X-Forwarded-For / -Proto
APP_TRUST_PROXY=false

# MySQL 8.0 (DB_PASS is still accepted for older .env files)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=splitwise_plus
DB_USER=splitwise_app
DB_PASSWORD=change_me
# seconds
DB_CONNECT_TIMEOUT=5
# true for managed MySQL (TLS). DB_SSL_CA = provider CA file; empty = system CA bundle.
DB_SSL=false
DB_SSL_CA=
# verify the server certificate when DB_SSL=true (keep true in production)
DB_SSL_VERIFY=true

# Sessions: database (shared by all instances) | files (single local server only)
SESSION_NAME=splitwise_sess
SESSION_DRIVER=database
# idle timeout, seconds
SESSION_LIFETIME=7200

# receipts, max 5 MB (stored in MySQL)
UPLOAD_MAX_BYTES=5242880
# mock e-mail output: file path or "stderr"; empty = storage/logs/mail.log (local) / stderr (production)
MAIL_LOG=

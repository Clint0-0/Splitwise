graph G {
graph [splines=false, outputorder=edgesfirst, bgcolor="white", pad=0.3, dpi=200];
node [fontname="Helvetica", fontsize=13, color="#111111", penwidth=1.4];
edge [color="#111111", penwidth=1.3];
"USER" [shape=box,  width=1.9, height=0.65, label="USER", fontname="Helvetica-Bold", pos="1.0,6.0!"];
"USER.user_id" [shape=ellipse,  label=<<u>user_id</u>>, fontsize=11, width=0.9, height=0.42, margin="0.04,0.02", pos="-0.57,6.54!"];

"ITEMIZED INTO" [shape=diamond, label="ITEMIZED INTO", fontsize=11, width=1.6, height=0.85, fontname="Helvetica-Bold", pos="8.75,3.4!"];
"ITEMIZED INTO" -- "EXPENSE" [dir=forward, arrowhead=teetee, arrowsize=1.1];
"ITEMIZED INTO" -- "EXPENSE_ITEM" [dir=forward, arrowhead=crowodot, arrowsize=1.1];
"ADDS" [shape=diamond, label="ADDS", fontsize=11, width=1.6, height=0.85, fontname="Helvetica-Bold", pos="11.5,3.5!"];
"ADDS" -- "EXPENSE" [dir=forward, arrowhead=teetee, arrowsize=1.1];
"ADDS" -- "EXPENSE_CHARGE" [dir=forward, arrowhead=crowodot, arrowsize=1.1];
"ATTACHES" [shape=diamond, label="ATTACHES", fontsize=11, width=1.6, height=0.85, fontname="Helvetica-Bold", pos="11.5,8.2!"];

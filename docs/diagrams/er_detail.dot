"CONSUMED BY" -- "EXPENSE_ITEM" [dir=forward, arrowhead=crowodot, arrowsize=1.1];
"CONSUMED BY.share_units" [shape=ellipse, label="share_units", fontsize=11, width=0.9, height=0.42, pos="3.6,3.5!"];

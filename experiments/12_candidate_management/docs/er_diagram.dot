digraph candidate_management {
  graph [rankdir=LR, splines=spline, nodesep=0.8, ranksep=1.4, fontname="Helvetica", label="Candidate Management System — ER diagram (generated from MySQL information_schema)\nPK primary key · FK foreign key · UK unique · ? nullable · crow's foot = many, bar = exactly one", labelloc=t, fontsize=14];
  node [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555", dir=both];
  applications [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#7A3E00"><font color="white"><b>applications</b></font></td></tr><tr><td align="left" port="application_id"><b>application_id</b></td><td align="left"><font color="#666666">int unsigned</font></td><td align="left" port="application_id_r"><font color="#1F4E79">PK</font></td></tr><tr><td align="left" port="candidate_id">candidate_id</td><td align="left"><font color="#666666">int unsigned</font></td><td align="left" port="candidate_id_r"><font color="#1F4E79">FK,UK</font></td></tr><tr><td align="left" port="position_id">position_id</td><td align="left"><font color="#666666">smallint unsigned</font></td><td align="left" port="position_id_r"><font color="#1F4E79">FK,UK</font></td></tr><tr><td align="left" port="applied_on">applied_on</td><td align="left"><font color="#666666">date</font></td><td align="left" port="applied_on_r"> </td></tr><tr><td align="left" port="status">status</td><td align="left"><font color="#666666">enum(&#039;Applied&#039;,&#039;Shortlisted&#039;,&#039;Interviewed&#039;,&#039;Selected&#039;,&#039;Rejected&#039;)</font></td><td align="left" port="status_r"> </td></tr></table>>];
  candidates [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#1F4E79"><font color="white"><b>candidates</b></font></td></tr><tr><td align="left" port="candidate_id"><b>candidate_id</b></td><td align="left"><font color="#666666">int unsigned</font></td><td align="left" port="candidate_id_r"><font color="#1F4E79">PK</font></td></tr><tr><td align="left" port="full_name">full_name</td><td align="left"><font color="#666666">varchar(100)</font></td><td align="left" port="full_name_r"> </td></tr><tr><td align="left" port="email">email</td><td align="left"><font color="#666666">varchar(150)</font></td><td align="left" port="email_r"><font color="#1F4E79">UK</font></td></tr><tr><td align="left" port="phone">phone</td><td align="left"><font color="#666666">char(10)</font></td><td align="left" port="phone_r"><font color="#1F4E79">UK</font></td></tr><tr><td align="left" port="date_of_birth">date_of_birth ?</td><td align="left"><font color="#666666">date</font></td><td align="left" port="date_of_birth_r"> </td></tr><tr><td align="left" port="highest_qualification">highest_qualification</td><td align="left"><font color="#666666">varchar(100)</font></td><td align="left" port="highest_qualification_r"> </td></tr><tr><td align="left" port="created_at">created_at</td><td align="left"><font color="#666666">datetime</font></td><td align="left" port="created_at_r"> </td></tr><tr><td align="left" port="updated_at">updated_at ?</td><td align="left"><font color="#666666">datetime</font></td><td align="left" port="updated_at_r"> </td></tr></table>>];
  positions [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#3B3B3B"><font color="white"><b>positions</b></font></td></tr><tr><td align="left" port="position_id"><b>position_id</b></td><td align="left"><font color="#666666">smallint unsigned</font></td><td align="left" port="position_id_r"><font color="#1F4E79">PK</font></td></tr><tr><td align="left" port="title">title</td><td align="left"><font color="#666666">varchar(80)</font></td><td align="left" port="title_r"><font color="#1F4E79">UK</font></td></tr><tr><td align="left" port="department">department</td><td align="left"><font color="#666666">varchar(60)</font></td><td align="left" port="department_r"> </td></tr><tr><td align="left" port="is_open">is_open</td><td align="left"><font color="#666666">tinyint(1)</font></td><td align="left" port="is_open_r"> </td></tr></table>>];
  candidates:candidate_id_r:e -> applications:candidate_id:w [arrowtail=teetee, arrowhead=crowodot, label="1 : N\non delete cascade"];
  positions:position_id_r:e -> applications:position_id:w [arrowtail=teetee, arrowhead=crowodot, label="1 : N\non delete restrict"];
}
